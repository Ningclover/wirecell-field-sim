+def scaled_current(times, current, amp, stretch, start):
+    '''Scale a current waveform by `amp` and stretch its tail in time.
+
+    Samples before index `start` keep their times.  Samples from
+    `start` on have their time offsets from times[start] multiplied by
+    `stretch`.  The result is re-interpolated onto the original
+    `times` grid.  Used for the ProtoDUNE-HD APA1 (V_w = 0 V) MCMC
+    tuning of the two outermost collection-plane paths.
+    '''
+    start = int(start)
+    t2 = times[start:]*stretch
+    t2 = t2 - (t2[0] - times[start])
+    times2 = numpy.concatenate((times[:start], t2))
+    return numpy.interp(times, times2, numpy.asarray(current)*amp)
+
